"1": {
&"character": "Narrator",
&"id": "1",
&"next_id": "2",
&"static_id": "",
&"text": "[speed=0.3]You lie on your bed, [$> changeScene(0,1)]awake. [$> changeScene(2,1)]The winds howl softly outside your window. [$> changeScene(0,2)]Lately, you've been feeling down in the dumps but can't figure out the reason why.",
&"type": "dialogue"
},
"10": {
&"character": "Narrator",
&"id": "10",
&"next_id": "11",
&"static_id": "",
&"text": "[speed=0.3][$> changeScene(11,10)]You let the sleep swallow you whole that night.",
&"type": "dialogue"
},
"11": {
&"id": "11",
&"mutation": {
